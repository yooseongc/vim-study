{
  "name": "vim-field-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/assets.mjs && vite build",
    "test": "node --test",
    "format": "prettier --write src scripts test index.html vite.config.js",
    "format:check": "prettier --check src scripts test index.html vite.config.js"
  },
  "dependencies": {
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inconsolata": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@fontsource/source-code-pro": "5.3.1",
    "coi-serviceworker": "0.1.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vim-wasm": "0.0.13"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.10.1",
    "vite": "7.3.8"
  }
}
